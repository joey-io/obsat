# Obsat built-in adapters do not require keys.
# Keep this file as a template for adapters you add later.

# NASA Earthdata user token
OBSAT_NASA_EARTHDATA_TOKEN=

# Copernicus Data Space OAuth client credentials
OBSAT_COPERNICUS_CLIENT_ID=
OBSAT_COPERNICUS_CLIENT_SECRET=

# Optional Microsoft Planetary Computer subscription key
OBSAT_PLANETARY_COMPUTER_KEY=
