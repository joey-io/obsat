# Every key below is free and optional. An adapter whose key is missing is
# skipped, not run and failed, so Obsat works with none of these set.
# Run `obsat auth status` to see which are configured.

# EPA AirNow — measured US air-quality observations
# https://docs.airnowapi.org/account/request/
OBSAT_AIRNOW_API_KEY=

# OpenAQ — global air-quality monitoring stations
# https://explore.openaq.org/register
OBSAT_OPENAQ_API_KEY=

# NASA FIRMS — active fire detections from VIIRS
# https://firms.modaps.eosdis.nasa.gov/api/area/
OBSAT_NASA_FIRMS_MAP_KEY=

# Reserved for future adapters. Not used by the current built-ins.
OBSAT_NASA_EARTHDATA_TOKEN=
OBSAT_COPERNICUS_CLIENT_ID=
OBSAT_COPERNICUS_CLIENT_SECRET=
OBSAT_PLANETARY_COMPUTER_KEY=
